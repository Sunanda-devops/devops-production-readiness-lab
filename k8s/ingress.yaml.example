apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: production-readiness-api
  namespace: production-rollout
  annotations:
    cert-manager.io/cluster-issuer: letsencrypt-prod
spec:
  ingressClassName: nginx
  tls:
    - hosts:
        - api.example.com
      secretName: production-readiness-api-tls
  rules:
    - host: api.example.com
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: production-readiness-api
                port:
                  name: http
